apiVersion: apps/v1
kind: Deployment
metadata:
  name: chatbot-backend
  namespace: {{ k8s_namespace }}
  labels:
    app: chatbot-backend
spec:
  replicas: 1
  selector:
    matchLabels:
      app: chatbot-backend
  template:
    metadata:
      labels:
        app: chatbot-backend
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/path: "/metrics"
        prometheus.io/port: "8000"
    spec:
      containers:
      - name: chatbot-backend
        image: {{ backend_image }}
        imagePullPolicy: Always
        ports:
        - containerPort: 8000
        env:
        - name: REDIS_HOST
          value: "redis-service"
        - name: DEFAULT_MODEL
          value: "{{ default_model | default('llama') }}"
        - name: VAULT_ADDR
          value: "{{ vault_addr | default('http://vault.vault.svc.cluster.local:8200') }}"
        - name: VAULT_TOKEN
          value: "{{ vault_root_token | default('root') }}"
        - name: GROQ_API_KEY
          valueFrom:
            secretKeyRef:
              name: llm-secrets
              key: GROQ_API_KEY
              optional: true
        - name: OPENAI_API_KEY
          valueFrom:
            secretKeyRef:
              name: llm-secrets
              key: OPENAI_API_KEY
              optional: true
        - name: MISTRAL_API_KEY
          valueFrom:
            secretKeyRef:
              name: llm-secrets
              key: MISTRAL_API_KEY
              optional: true
        - name: GROK_API_KEY
          valueFrom:
            secretKeyRef:
              name: llm-secrets
              key: GROK_API_KEY
              optional: true
        resources:
          requests:
            cpu: "250m"
            memory: "256Mi"
          limits:
            cpu: "500m"
            memory: "512Mi"
        readinessProbe:
          httpGet:
            path: /health
            port: 8000
          initialDelaySeconds: 10
          periodSeconds: 10
          failureThreshold: 5
---
apiVersion: v1
kind: Service
metadata:
  name: chatbot-service
  namespace: {{ k8s_namespace }}
spec:
  selector:
    app: chatbot-backend
  ports:
  - port: 80
    targetPort: 8000
  type: ClusterIP
